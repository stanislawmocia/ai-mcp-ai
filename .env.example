# MeshMind Hub Configuration
# Copy to .env and set your values

# Shared auth token — same on hub and all nodes
HUB_TOKEN=change-me-to-a-strong-random-token

# Hub Core
HUB_PORT=7433
DB_PATH=/data/hub.db

# Hub MCP
MCP_PORT=7434
MCP_TRANSPORT=sse
HUB_URL=http://localhost:7433

# Node Agent (for local node on HP Server)
NODE_NAME=hp-server
AGENT_PORT=7432
AGENT_LOG_DIR=/tmp/meshmind-agents
