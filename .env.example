# ── Required ──────────────────────────────────────────────────────────────
# Passphrase used to encrypt your private key in the SQLite database.
# Use the SAME value on the same machine. If you change it, delete comm.db.
MCP_COMM_KEY_PASSPHRASE=change-me-strong-passphrase

# ── Optional overrides ────────────────────────────────────────────────────

# Path to your config.json (default: ./config.json inside container)
# MCP_COMM_CONFIG=/app/config.json

# Override the device alias shown to peers
# MCP_COMM_ALIAS=my-claude

# Override the HTTP port (default: 7432)
# MCP_COMM_PORT=7432

# Override the SQLite DB path (default: /data/comm.db in Docker)
# MCP_COMM_DB_PATH=/data/comm.db

# ── Cross-platform / Docker ──────────────────────────────────────────────

# Your Tailscale IP — REQUIRED on macOS/Windows where the Docker container
# cannot access the host's Tailscale daemon socket.
# Find it with: tailscale ip --4
# TAILSCALE_IP=100.x.x.x

# Tailscale socket path override (if non-standard location)
# TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock

# Force bind address for HTTP server (default: auto-detect)
# Use 0.0.0.0 to accept connections on all interfaces
# MCP_COMM_BIND_ADDRESS=0.0.0.0

# ── Multi-session ────────────────────────────────────────────────────────

# Set a fixed session ID (default: random 4-hex per startup).
# Useful for Docker containers so the session ID is predictable.
# MCP_COMM_SESSION_ID=main
