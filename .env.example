# MeshMind Hub Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#   openssl rand -hex 32   ← use this to generate HUB_TOKEN

# ──── Auth ────────────────────────────────────────────────────────────────────
# Shared secret — must be identical on hub and every node (min 32 chars)
# Generate with: openssl rand -hex 32
HUB_TOKEN=change-me-to-a-strong-random-token

# ──── Network Binding ────────────────────────────────────────────────────────
# IMPORTANT: Set this to your Tailscale IP to restrict access to Tailscale only.
# Default: 127.0.0.1 (localhost only — safe default)
# Use 0.0.0.0 ONLY if you have a firewall and know what you're doing.
# Example: BIND_HOST=100.64.1.10  (your Tailscale IP)
BIND_HOST=127.0.0.1

# ──── TLS ─────────────────────────────────────────────────────────────────────
# Generate Tailscale certs: tailscale cert <machine-name>.<tailnet>.ts.net
# Then set paths below:
# TLS_CERT=/certs/machine.crt
# TLS_KEY=/certs/machine.key
TLS_CERT=
TLS_KEY=
# Directory mounted into containers (host path):
TLS_CERT_DIR=./certs

# ──── Hub Core (:7433) ────────────────────────────────────────────────────────
HUB_PORT=7433
DB_PATH=/data/hub.db

# ──── Hub MCP (:7434) ─────────────────────────────────────────────────────────
MCP_PORT=7434
MCP_TRANSPORT=sse
HUB_URL=http://hub-core:7433

# ──── OAuth 2.0 (MCP authentication) ─────────────────────────────────────────
# Pre-register a single OAuth client for yourself.
# Generate: openssl rand -hex 32 (for both ID and secret)
# When set, only this client can authenticate via MCP.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Comma-separated Tailscale IPs allowed to authenticate via OAuth.
# Leave empty to allow any IP (not recommended in production).
# Example: OAUTH_ALLOWED_IPS=100.64.1.10,100.64.1.20
OAUTH_ALLOWED_IPS=

# ──── Local Node Agent (:7432) ────────────────────────────────────────────────
# Only used when running with --profile with-local-node
# NODE_NAME appears in `hub status` and MCP tool calls (nodeName: "...")
NODE_NAME=hp-server
AGENT_PORT=7432
AGENT_LOG_DIR=/tmp/meshmind-agents

# ──── Command Restrictions ────────────────────────────────────────────────────
# Control which shell commands the node is allowed to execute via exec_on.
# NOTE: Shell metacharacters (;|&`$(){}[]<>!#) are ALWAYS blocked to prevent
# command injection. Use separate exec_on calls instead of command chaining.

# EXEC_ALLOWLIST — whitelist: only these binaries are permitted.
# If set, any command not on the list is rejected with exit code 1.
# Example (read-only + docker + git):
# EXEC_ALLOWLIST=docker,git,ls,cat,head,tail,uname,df,free,ps,env
EXEC_ALLOWLIST=

# EXEC_DENYLIST — blacklist: these are ALWAYS blocked (in addition to defaults).
# Default denylist includes: rm, dd, mkfs, fdisk, chmod, chown, chroot, reboot,
# shutdown, kill, killall, iptables, useradd, passwd, su, sudo, nc, wget, curl,
# ssh, eval, exec, crontab, at (and more).
# Add your own here:
EXEC_DENYLIST=

# EXEC_ALLOWED_WORKDIRS — restrict which directories can be used as workdir.
# Comma-separated absolute paths. Commands can only execute in these directories.
# Leave empty to allow any directory (still blocks path traversal with "..").
# Example: EXEC_ALLOWED_WORKDIRS=/home/user/projects,/opt/deploy
EXEC_ALLOWED_WORKDIRS=
