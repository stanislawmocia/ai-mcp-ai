# MeshMind Hub Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#   openssl rand -hex 32   ← use this to generate HUB_TOKEN

# ──── Auth ────────────────────────────────────────────────────────────────────
# Shared secret — must be identical on hub and every node
# Generate with: openssl rand -hex 32
HUB_TOKEN=change-me-to-a-strong-random-token

# ──── Hub Core (:7433) ────────────────────────────────────────────────────────
HUB_PORT=7433
DB_PATH=/data/hub.db

# ──── Hub MCP (:7434) ─────────────────────────────────────────────────────────
MCP_PORT=7434
MCP_TRANSPORT=sse
HUB_URL=http://localhost:7433

# ──── Local Node Agent (:7432) ────────────────────────────────────────────────
# Only used when running with --profile with-local-node
# NODE_NAME appears in `hub status` and MCP tool calls (nodeName: "...")
NODE_NAME=hp-server
AGENT_PORT=7432
AGENT_LOG_DIR=/tmp/meshmind-agents

# ──── Command restrictions ────────────────────────────────────────────────────
# Control which shell commands the node is allowed to execute via exec_on.
# Both variables are optional — leave empty to allow everything (default).
# Comma-separated list of binary names (no paths, no arguments).

# EXEC_ALLOWLIST — whitelist: only these binaries are permitted.
# If set, any command not on the list is rejected with exit code 1.
# Example (read-only + docker):
# EXEC_ALLOWLIST=docker,git,ls,cat,head,tail,curl,wget,uname,df,free,ps,env
EXEC_ALLOWLIST=

# EXEC_DENYLIST — blacklist: these binaries are always blocked, even if EXEC_ALLOWLIST is empty.
# Checked before the allowlist.
# Example (block destructive commands):
# EXEC_DENYLIST=rm,dd,mkfs,fdisk,chmod,chown,reboot,shutdown,poweroff,kill,killall
EXEC_DENYLIST=
